<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.octopus.demo.admin.mapper.LoginLogMapper">

    <resultMap id="loginLogMap" type="com.octopus.demo.admin.entity.SysLoginLog">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="ip" column="ip"/>
        <result property="userAgent" column="user_agent"/>
        <result property="status" column="status"/>
        <result property="message" column="message"/>
        <result property="loginAt" column="login_at"/>
    </resultMap>

    <sql id="columns">
        id, username, ip, user_agent, status, message, login_at
    </sql>

    <sql id="filters">
        <if test="username != null and username != ''">
            AND username = #{username}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="from != null">
            AND login_at &gt;= #{from}
        </if>
        <if test="to != null">
            AND login_at &lt;= #{to}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_login_log (username, ip, user_agent, status, message, login_at)
        VALUES (#{username}, #{ip}, #{userAgent}, #{status}, #{message}, #{loginAt})
    </insert>

    <select id="findPage" resultMap="loginLogMap">
        SELECT <include refid="columns"/> FROM sys_login_log
        WHERE 1 = 1
        <include refid="filters"/>
        ORDER BY login_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sys_login_log
        WHERE 1 = 1
        <include refid="filters"/>
    </select>

</mapper>
