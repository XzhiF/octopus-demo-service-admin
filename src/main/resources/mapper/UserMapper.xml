<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.octopus.demo.admin.mapper.UserMapper">

    <resultMap id="detailMap" type="com.octopus.demo.admin.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password_hash"/>
        <result property="nickname" column="nickname"/>
        <result property="gender" column="gender"/>
        <result property="status" column="status"/>
        <collection property="roles" ofType="com.octopus.demo.admin.entity.SysRole">
            <id property="id" column="role_id"/>
            <result property="name" column="role_name"/>
            <result property="code" column="role_code"/>
            <collection property="resources" ofType="com.octopus.demo.admin.entity.SysResource">
                <id property="id" column="menu_id"/>
                <result property="parentId" column="menu_parent_id"/>
                <result property="name" column="menu_name"/>
                <result property="code" column="menu_perms"/>
                <result property="type" column="menu_type"/>
                <result property="path" column="menu_path"/>
                <result property="component" column="menu_component"/>
                <result property="icon" column="menu_icon"/>
                <result property="sort" column="menu_sort"/>
                <result property="visible" column="menu_visible"/>
                <result property="status" column="menu_status"/>
            </collection>
        </collection>
    </resultMap>

    <resultMap id="basicMap" type="com.octopus.demo.admin.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password_hash"/>
        <result property="nickname" column="nickname"/>
        <result property="gender" column="gender"/>
        <result property="status" column="status"/>
    </resultMap>

    <resultMap id="roleBasicMap" type="com.octopus.demo.admin.entity.SysRole">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
    </resultMap>

    <sql id="userFilter">
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <sql id="detailColumns">
        SELECT u.id, u.username, u.password_hash, u.nickname, u.gender, u.status,
               r.id AS role_id, r.name AS role_name, r.code AS role_code,
               m.id AS menu_id, m.parent_id AS menu_parent_id, m.name AS menu_name,
               m.perms AS menu_perms, m.type AS menu_type, m.path AS menu_path,
               m.component AS menu_component, m.icon AS menu_icon, m.sort AS menu_sort,
               m.visible AS menu_visible, m.status AS menu_status
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON ur.user_id = u.id
        LEFT JOIN sys_role r ON r.id = ur.role_id AND r.status = 1
        LEFT JOIN sys_role_menu rm ON rm.role_id = r.id
        LEFT JOIN sys_menu m ON m.id = rm.menu_id AND m.status = 1
    </sql>

    <select id="findById" resultMap="detailMap">
        <include refid="detailColumns"/>
        WHERE u.id = #{id}
    </select>

    <select id="findByUsername" resultMap="detailMap">
        <include refid="detailColumns"/>
        WHERE u.username = #{username}
    </select>

    <select id="findAll" resultMap="basicMap">
        SELECT id, username, password_hash, nickname, gender, status FROM sys_user ORDER BY id
    </select>

    <select id="findPage" resultMap="basicMap">
        SELECT id, username, password_hash, nickname, gender, status FROM sys_user
        <include refid="userFilter"/>
        ORDER BY id LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sys_user
        <include refid="userFilter"/>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password_hash, nickname, gender, status)
        VALUES (#{username}, #{password}, #{nickname}, #{gender}, COALESCE(#{status}, 1))
    </insert>

    <update id="update">
        UPDATE sys_user
        SET username = #{username},
            nickname = #{nickname},
            gender = #{gender},
            password_hash = COALESCE(#{password}, password_hash),
            status = COALESCE(#{status}, status)
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE sys_user SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE sys_user SET password_hash = #{password} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

    <delete id="deleteUserRoles">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

    <insert id="insertUserRole">
        INSERT IGNORE INTO sys_user_role (user_id, role_id) VALUES (#{userId}, #{roleId})
    </insert>

    <select id="findRolesByUserId" resultMap="roleBasicMap">
        SELECT r.id, r.name, r.code
        FROM sys_role r
        JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
        ORDER BY r.id
    </select>

</mapper>
