<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.octopus.demo.admin.mapper.JobLogMapper">

    <resultMap id="jobLogMap" type="com.octopus.demo.admin.entity.SysJobLog">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="jobName" column="job_name"/>
        <result property="status" column="status"/>
        <result property="message" column="message"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="triggerType" column="trigger_type"/>
    </resultMap>

    <sql id="columns">
        id, job_id, job_name, status, message, started_at, finished_at, duration_ms, trigger_type
    </sql>

    <sql id="filters">
        <if test="jobId != null">
            AND job_id = #{jobId}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="from != null">
            AND started_at &gt;= #{from}
        </if>
        <if test="to != null">
            AND started_at &lt;= #{to}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_job_log (job_id, job_name, status, message, started_at, finished_at, duration_ms, trigger_type)
        VALUES (#{jobId}, #{jobName}, #{status}, #{message}, #{startedAt}, #{finishedAt}, #{durationMs}, #{triggerType})
    </insert>

    <select id="findPage" resultMap="jobLogMap">
        SELECT <include refid="columns"/> FROM sys_job_log
        WHERE 1 = 1
        <include refid="filters"/>
        ORDER BY started_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sys_job_log
        WHERE 1 = 1
        <include refid="filters"/>
    </select>

</mapper>
